    <script>
        function renderRing(id, nilai, warna) {
            new Chart(document.getElementById(id), {
                type: 'doughnut',
                data: {
                    datasets: [{
                        data: [nilai, 100 - nilai],
                        backgroundColor: [warna, '#E5E7EB'],
                        borderWidth: 0
                    }]
                },
                options: {
                    cutout: '80%',
                    plugins: {
                        tooltip: {
                            enabled: false
                        },
                        legend: {
                            display: false
                        },
                        annotation: {
                            annotations: {
                                label: {
                                    type: 'label',
                                    content: nilai + '%',
                                    font: {
                                        size: 16,
                                        weight: 'bold'
                                    }
                                }
                            }
                        }
                    }
                }
            });
        }

        renderRing("ringTeamwork", <?= round($conn->query("SELECT AVG(teamwork) as avg FROM penilaian")->fetch_assoc()['avg']) ?>, "#60A5FA");
        renderRing("ringDisiplin", <?= round($conn->query("SELECT AVG(disiplin) as avg FROM penilaian")->fetch_assoc()['avg']) ?>, "#34D399");
        renderRing("ringTanggungJawab", <?= round($conn->query("SELECT AVG(tanggung_jawab) as avg FROM penilaian")->fetch_assoc()['avg']) ?>, "#FBBF24");
        renderRing("ringProduktivitas", <?= round($conn->query("SELECT AVG(produktivitas) as avg FROM penilaian")->fetch_assoc()['avg']) ?>, "#F87171");
    </script>


